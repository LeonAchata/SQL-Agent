# Claude API key (https://console.anthropic.com). Required.
ANTHROPIC_API_KEY=

# Any SQLAlchemy URL. Use a read-only database role in production.
#   postgresql+psycopg://user:pass@host:5432/db
#   mysql+pymysql://user:pass@host:3306/db
#   sqlite:///data/chinook.sqlite
SQLAGENT_DATABASE_URL=sqlite:///data/chinook.sqlite

# Optional tuning (defaults shown)
# SQLAGENT_MODEL=claude-opus-5-5
# SQLAGENT_EFFORT=medium
# SQLAGENT_MAX_ROWS=200
# SQLAGENT_STATEMENT_TIMEOUT_MS=15000
# SQLAGENT_SCHEMAS=["public"]
# SQLAGENT_EXCLUDE_TABLES=["audit_log"]
# SQLAGENT_SEMANTIC_LAYER_PATH=semantic/chinook.postgres.yaml
